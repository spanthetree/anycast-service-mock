{# Stand-in core switch: peers with every route server, ECMP on. #}
[global.config]
  as = {{ core_asn }}
  router-id = "{{ item }}"

[global.use-multiple-paths.config]
  enabled = true
{% for rs in route_servers %}

[[neighbors]]
  [neighbors.config]
    neighbor-address = "{{ rs.address }}"
    peer-as = {{ rs_asn }}
{% endfor %}
