#!/usr/bin/env python3
"""Print the BGP routes this FRR core switch installed in the kernel:
one line per next hop, "<prefix> <next hop> " (trailing space for exact matching)."""
import json
import subprocess

routes = json.loads(subprocess.check_output(["vtysh", "-c", "show ip route bgp json"]))
for prefix, entries in sorted(routes.items()):
    for route in entries:
        if not route.get("installed"):
            continue
        for nh in route.get("nexthops", []):
            if nh.get("fib"):
                print(prefix, nh.get("ip", "?"), "")
