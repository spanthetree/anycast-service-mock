#!/usr/bin/env python3
"""Print this FRR core switch's BGP sessions: "<neighbor> <AS> <state>"."""
import json
import subprocess

peers = json.loads(subprocess.check_output(["vtysh", "-c", "show bgp neighbors json"]))
for addr, peer in sorted(peers.items()):
    print(addr, peer.get("remoteAs"), peer.get("bgpState"))
