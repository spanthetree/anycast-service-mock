[Unit]
Description=GoBGP Anycast Route Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ routeserver_user }}
Group={{ routeserver_group }}
ExecStart=/usr/bin/gobgpd -f {{ routeserver_config_file }}
Restart=always
RestartSec=5
# BGP listens on tcp/179, a privileged port; agents connect in to it
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
