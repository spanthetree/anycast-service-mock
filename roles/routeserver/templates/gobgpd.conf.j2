[global.config]
  as = {{ rs_asn }}
  router-id = "{{ routeserver_router_id }}"

{% if routeserver_multipath_enabled | bool %}
[global.use-multiple-paths.config]
  enabled = true
{% endif %}

{% for prefix in anycast_allowed_prefixes %}
[[defined-sets.prefix-sets]]
  prefix-set-name = "ANYCAST_VIPS_{{ loop.index }}"

  [[defined-sets.prefix-sets.prefix-list]]
    ip-prefix = "{{ prefix }}"
    masklength-range = "32..32"
{% endfor %}

[[policy-definitions]]
  name = "ALLOW_ANYCAST_VIPS"

{% for prefix in anycast_allowed_prefixes %}
  [[policy-definitions.statements]]
    name = "allow-anycast-vips-{{ loop.index }}"

    [policy-definitions.statements.conditions.match-prefix-set]
      prefix-set = "ANYCAST_VIPS_{{ loop.index }}"
      match-set-options = "any"

    [policy-definitions.statements.actions]
      route-disposition = "accept-route"
{% endfor %}

[[policy-definitions]]
  name = "REJECT_OTHER_PREFIXES"

  [[policy-definitions.statements]]
    name = "reject-default"

    [policy-definitions.statements.actions]
      route-disposition = "reject-route"

{% for peer in core_peers %}
[[neighbors]]
  [neighbors.config]
    neighbor-address = "{{ peer }}"
    peer-as = {{ core_asn }}

  [neighbors.apply-policy.config]
    export-policy-list = ["ALLOW_ANYCAST_VIPS", "REJECT_OTHER_PREFIXES"]
    default-export-policy = "reject-route"
{% endfor %}

{% for prefix in agent_neighbor_prefixes %}
[[dynamic-neighbors]]
  [dynamic-neighbors.config]
    prefix = "{{ prefix }}"
    peer-group = "ANYCAST_AGENTS"
{% endfor %}

[[peer-groups]]
  [peer-groups.config]
    peer-group-name = "ANYCAST_AGENTS"
    peer-as = {{ gocast_asn }}
{% if gocast_asn | int != rs_asn | int %}

  # agents sit on other subnets, so eBGP sessions to them are multihop;
  # GoCast enables multihop on its side for eBGP peers by default too
  [peer-groups.ebgp-multihop.config]
    enabled = true
    multihop-ttl = 255
{% endif %}

  [peer-groups.apply-policy.config]
    import-policy-list = ["ALLOW_ANYCAST_VIPS", "REJECT_OTHER_PREFIXES"]
    default-import-policy = "reject-route"
