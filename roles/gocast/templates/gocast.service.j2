{% set gocast_dependent_units = anycast_services | default([]) | selectattr('anycast', 'defined') | selectattr('anycast') | selectattr('vip', 'defined') | selectattr('vip') | selectattr('monitor', 'defined') | selectattr('monitor') | selectattr('service_unit', 'defined') | map(attribute='service_unit') | list %}
[Unit]
Description=GoCast Anycast Agent
After=network-online.target{% for unit in gocast_dependent_units %} {{ unit }}{% endfor +%}
Wants=network-online.target{% for unit in gocast_dependent_units %} {{ unit }}{% endfor +%}

[Service]
Type=simple
User={{ gocast_user }}
Group={{ gocast_group }}
ExecStart={{ gocast_binary }} -logtostderr -v={{ gocast_log_level }} -config {{ gocast_config_dir }}/gocast.yaml
Restart=always
RestartSec=5
{% if gocast_capabilities | bool %}
# NET_BIND_SERVICE: GoCast's port monitor checks a port by trying to bind it
# and treats any bind error as "service up". Without it, binding a port below
# 1024 always fails with EACCES, so those monitors would never go down.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
{% endif %}

[Install]
WantedBy=multi-user.target
