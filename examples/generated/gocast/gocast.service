[Unit]
Description=GoCast Anycast Agent
After=network-online.target bind9.service rsyslog.service
Wants=network-online.target bind9.service rsyslog.service

[Service]
Type=simple
User=gocast
Group=gocast
ExecStart=/usr/local/bin/gocast -logtostderr -v=2 -config /etc/gocast/gocast.yaml
Restart=always
RestartSec=5
# NET_BIND_SERVICE: GoCast's port monitor checks a port by trying to bind it
# and treats any bind error as "service up". Without it, binding a port below
# 1024 always fails with EACCES, so those monitors would never go down.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
